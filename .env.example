# ---------------------------------------------------------------------------
# elevate-login-test - environment template
# Copy to .env for local runs. NEVER commit a real .env file.
# Leave every secret blank here; blank values make the matching tests skip.
# ---------------------------------------------------------------------------

# --- Target URLs -----------------------------------------------------------
ELEVATE_LOGIN_URL=https://elevate.hellothinkster.com/login

# Verified 2026-09-28: the login page's "Sign up for a free trial" link points at
#   https://hellothinkster.com/start/sign-up.html
# which 308-redirects twice to the canonical page below.
FREE_TRIAL_URL=https://www.hellothinkster.com/start/sign-up

# --- Parent login credentials (secrets - leave blank unless authorized) ----
ELEVATE_PARENT_EMAIL=
ELEVATE_PARENT_PASSWORD=

# --- Non-secret parent test data ------------------------------------------
PARENT_FIRST_NAME=Mukesh
PARENT_LAST_NAME=Automation
PARENT_COUNTRY=United States
PARENT_COUNTRY_CODE=+1
# 10 digits, no formatting. The UI masks it to (XXX) XXX-XXXX automatically.
PARENT_PHONE=

# --- Student data ----------------------------------------------------------
STUDENT_FIRST_NAME=Mukesh
STUDENT_GRADE=5

# --- Billing (non-secret) --------------------------------------------------
BILLING_POSTAL_CODE=07001
BILLING_COUNTRY=United States

# --- Payment secrets: APPROVED SANDBOX TEST CARDS ONLY --------------------
# Never commit a real PAN or CVV. Never put these in a screenshot or report.
TEST_CARD_NUMBER=
TEST_CARD_EXPIRY=
TEST_CARD_CVC=

# --- OTP (sandbox only) ----------------------------------------------------
SANDBOX_OTP=

# --- Runner options --------------------------------------------------------
# Uses the installed system Chrome instead of downloading Chromium.
BROWSER_CHANNEL=chrome
# 'off' avoids requiring FFmpeg.
VIDEO=off

# --- Destructive-action gates (all default to false) ----------------------
# RUN_LIVE_SIGNUP=true allows any action that writes to the Thinkster backend.
# NOTE: on the real site, clicking Continue on signup step 1 already POSTs to
#       /api/register/lead, so even reaching step 2 needs this flag.
RUN_LIVE_SIGNUP=false
# RUN_PAYMENT=true allows card entry / subscription activation. Requires
# RUN_LIVE_SIGNUP=true and an explicitly authorized payment sandbox.
RUN_PAYMENT=false
# Allows generating a brand-new unique email for a real registration attempt.
ALLOW_UNIQUE_EMAIL=false
# Allows actually submitting Forgot Password (sends a real recovery email).
SEND_PASSWORD_RESET=false

# Optional: pin the unique-email suffix (otherwise a timestamp is used).
# EMAIL_UNIQUE_SUFFIX=

# --- Approved test email domain -------------------------------------------
# EVERY address this suite types into a Thinkster form uses this domain.
# Do NOT change it to example.com, a personal inbox, or a real customer address:
# signup step 1 POSTs to /api/register/lead, so anything entered there becomes a
# real lead in Thinkster's CRM.
TEST_EMAIL_DOMAIN=tabtortest.com
