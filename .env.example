# ---------------------------------------------------------------------------
# Thinkster sandbox QA automation - local environment template
# Copy to .env for local runs.  In Jenkins these come from Credentials.
# NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Environment (sandbox only - the suite refuses non-sandbox hosts) -------
SANDBOX_BASE_URL=https://sandbox.hellothinkster.com
ELEVATE_STUDENTS_URL=https://elevate-sandbox.hellothinkster.com/students
EXPECTED_PAYMENT_HOST=cde.openpaystaging.com

# Elevate login URL (used by the login suite)
ELEVATE_LOGIN_URL=https://elevate.hellothinkster.com/login

# Free-trial signup canonical URL (verified redirect chain 2026-09-28)
FREE_TRIAL_URL=https://www.hellothinkster.com/start/sign-up

# --- Parent login credentials (secrets - never commit real values) ----------
# ELEVATE_PARENT_EMAIL is read by test-data.ts for the login suite.
# PARENT_PASSWORD / ELEVATE_PARENT_PASSWORD are both supported;
# PARENT_PASSWORD is the sandbox-aligned name, ELEVATE_PARENT_PASSWORD is the
# legacy name kept for backward compatibility with the login suite.
ELEVATE_PARENT_EMAIL=
PARENT_PASSWORD=12345678
ELEVATE_PARENT_PASSWORD=12345678

# --- QA bypass header (sandbox environments only - leave blank on production) --
# Injected as a request header to skip rate-limiting and bot-detection in the
# sandbox.  Treat as a secret: never log or print this value.
THINKSTER_QA_BYPASS=

# --- OTP (sandbox fixed value - never a real OTP) --------------------------
SANDBOX_OTP=123123

# --- Payment secrets: APPROVED SANDBOX TEST CARDS ONLY --------------------
# 4111111111111111 is the standard Visa sandbox PAN (publicly documented).
# Never substitute a real card number, expiry or CVV here.
SANDBOX_CARD_NUMBER=4111111111111111
SANDBOX_CARD_EXPIRY=12/30
SANDBOX_CARD_CVC=123

# Legacy names kept for test-data.ts backward compatibility
TEST_CARD_NUMBER=4111111111111111
TEST_CARD_EXPIRY=12/30
TEST_CARD_CVC=123

# --- Non-secret parent test data ------------------------------------------
PARENT_FIRST_NAME=Test
PARENT_LAST_NAME=Automation
PARENT_COUNTRY=United States
PARENT_COUNTRY_CODE=+1
# Pre-formatted (XXX) XXX-XXXX  - the login suite also accepts 10 raw digits.
PARENT_PHONE=(908) 020-4336

# --- Student data ----------------------------------------------------------
STUDENT_FIRST_NAME=Test
STUDENT_GRADE=5

# --- Billing (non-secret) --------------------------------------------------
BILLING_POSTAL_CODE=07001
BILLING_COUNTRY=United States

# --- Scheduling -----------------------------------------------------------
# Timezone used for the appointment picker (also sets the browser timezone).
APPOINTMENT_TIMEZONE=America/New_York

# --- Approved test email domain -------------------------------------------
# EVERY address this suite types into a Thinkster form must use this domain.
# Signup step 1 POSTs to /api/register/lead, so any address entered there
# becomes a real lead in Thinkster's CRM.  Never use example.com, a personal
# inbox, or a real customer address.
TEST_EMAIL_DOMAIN=tabtortest.com

# Optional: pin the unique-email suffix (normally derived from BUILD_NUMBER).
# EMAIL_UNIQUE_SUFFIX=

# --- Runner options --------------------------------------------------------
# Uses the system-installed Google Chrome; no Chromium download required.
BROWSER_CHANNEL=chrome
# 'off' avoids requiring FFmpeg.
VIDEO=off

# --- Destructive-action gates (all default to false) ----------------------
# RUN_LIVE_SIGNUP=true  allows any write to the Thinkster backend.
RUN_LIVE_SIGNUP=false
# RUN_PAYMENT=true  allows card entry / subscription.  Requires RUN_LIVE_SIGNUP.
RUN_PAYMENT=false
# ALLOW_UNIQUE_EMAIL=true  generates a fresh address for a real registration.
ALLOW_UNIQUE_EMAIL=false
# SEND_PASSWORD_RESET=true  submits the Forgot Password form (sends a real email).
SEND_PASSWORD_RESET=false
